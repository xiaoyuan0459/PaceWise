{
  "name": "zeppbridge",
  "private": true,
  "version": "3.2.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:functions": "node --test tests/zepp-oauth-functions.test.mjs tests/zepp-callback-functions.test.mjs tests/privacy-check.test.mjs",
    "docs:check": "node scripts/release/check-doc-links.mjs",
    "version:check": "node scripts/release/check-version-consistency.mjs",
    "privacy:scan": "node scripts/privacy/check.mjs --tree",
    "relay:migrate": "wrangler d1 migrations apply zeppbridge-official --remote --migrations-dir migrations-official",
    "relay:deploy": "wrangler pages deploy public --project-name=zeppbridge --branch=main",
    "hooks:install": "node scripts/privacy/install-hooks.mjs",
    "prepare": "node scripts/privacy/install-hooks.mjs"
  }
}
